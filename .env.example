# Copy to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables.
# No NEXT_PUBLIC_ prefix means server-only: never bundled into client code.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_BUCKET_URL=https://your-project-ref.supabase.co/storage/v1/object/public/bucket-name
